<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- BaseToolbar Title text appearance (Material 3 small top app bar title). -->
    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.Material3.TitleLarge"/>

    <!-- BaseToolbar Subtitle text appearance (Material 3 small top app bar subtitle). -->
    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.Material3.LabelMedium"/>





    <!--
     BaseDialog Title Panel materialAlertDialogTitlePanelStyle.
     Plain Material 3 title, kept for compatibility.
     https://github.com/material-components/material-components-android/blob/master/docs/components/Dialog.md
    -->
    <style name="BaseDialog.Title.Panel" parent="@style/MaterialAlertDialog.Material3Expressive.Title.Panel"/>


    <!--
     BaseDialog Message Text Light materialAlertDialogBodyTextStyle.
     https://github.com/material-components/material-components-android/blob/master/docs/components/Dialog.md
    -->
    <style name="BaseDialog.Message.Text.Light" parent="@style/MaterialAlertDialog.Material3.Body.Text">
        <!-- Text color. -->
        <item name="android:textColorLink">@color/blue_link_light</item>
    </style>

    <!--
     BaseDialog Message Text Dark materialAlertDialogBodyTextStyle.
     https://github.com/material-components/material-components-android/blob/master/docs/components/Dialog.md
    -->
    <style name="BaseDialog.Message.Text.Dark" parent="@style/MaterialAlertDialog.Material3.Body.Text">
        <!-- Text color. -->
        <item name="android:textColorLink">@color/blue_link_dark</item>
    </style>





    <!-- ViewDivider style. -->
    <style name="ViewDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/activity_vertical_margin</item>
        <item name="android:layout_marginBottom">@dimen/activity_vertical_margin</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

</resources>
