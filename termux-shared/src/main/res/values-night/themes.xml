<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     https://m3.material.io/develop/android/mdc-android
    -->

    <!--
     BaseActivity DayNight DarkActionBar theme.
     https://github.com/material-components/material-components-android/blob/master/lib/java/com/google/android/material/theme/res/values/themes.xml
    -->
    <style name="Theme.BaseActivity.DayNight.DarkActionBar" parent="Base.Theme.BaseActivity.Dark">
        <item name="colorPrimary">@color/termux_dark_primary</item>
        <item name="colorOnPrimary">@color/termux_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/termux_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/termux_dark_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/termux_dark_inverse_primary</item>
        <item name="colorPrimaryFixed">@color/termux_dark_primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/termux_dark_primary_fixed_dim</item>
        <item name="colorOnPrimaryFixed">@color/termux_dark_on_primary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/termux_dark_on_primary_fixed_variant</item>
        <item name="colorSecondary">@color/termux_dark_secondary</item>
        <item name="colorOnSecondary">@color/termux_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/termux_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/termux_dark_on_secondary_container</item>
        <item name="colorSecondaryFixed">@color/termux_dark_secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/termux_dark_secondary_fixed_dim</item>
        <item name="colorOnSecondaryFixed">@color/termux_dark_on_secondary_fixed</item>
        <item name="colorOnSecondaryFixedVariant">@color/termux_dark_on_secondary_fixed_variant</item>
        <item name="colorTertiary">@color/termux_dark_tertiary</item>
        <item name="colorOnTertiary">@color/termux_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/termux_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/termux_dark_on_tertiary_container</item>
        <item name="colorTertiaryFixed">@color/termux_dark_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/termux_dark_tertiary_fixed_dim</item>
        <item name="colorOnTertiaryFixed">@color/termux_dark_on_tertiary_fixed</item>
        <item name="colorOnTertiaryFixedVariant">@color/termux_dark_on_tertiary_fixed_variant</item>
        <item name="colorError">@color/termux_dark_error</item>
        <item name="colorOnError">@color/termux_dark_on_error</item>
        <item name="colorErrorContainer">@color/termux_dark_error_container</item>
        <item name="colorOnErrorContainer">@color/termux_dark_on_error_container</item>
        <item name="android:colorBackground">@color/termux_dark_background</item>
        <item name="colorOnBackground">@color/termux_dark_on_background</item>
        <item name="colorSurface">@color/termux_dark_surface</item>
        <item name="colorOnSurface">@color/termux_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/termux_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/termux_dark_on_surface_variant</item>
        <item name="colorSurfaceDim">@color/termux_dark_surface_dim</item>
        <item name="colorSurfaceBright">@color/termux_dark_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/termux_dark_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/termux_dark_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/termux_dark_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/termux_dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/termux_dark_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/termux_dark_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/termux_dark_inverse_on_surface</item>
        <item name="colorOutline">@color/termux_dark_outline</item>
        <item name="colorOutlineVariant">@color/termux_dark_outline_variant</item>

        <!-- System bars blend with the top app bar. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text color. -->
        <item name="android:textColorLink">@color/blue_link_dark</item>

        <!-- Dialog Themes, see values/themes.xml. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BaseDialog.AppCompat.DayNight</item>
        <!-- Framework dialogs, like the terminal context menu. -->
        <item name="android:alertDialogTheme">@style/ThemeOverlay.BaseDialog.Framework.DayNight</item>
    </style>

    <!-- BaseActivity DayNight NoActionBar theme. -->
    <style name="Theme.BaseActivity.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>





    <!--
      BaseDialog DayNight theme.
      Colours come from the context theme, so that dynamic colours apply to dialogs too.
      https://github.com/material-components/material-components-android/blob/master/docs/components/Dialog.md
     -->
    <style name="ThemeOverlay.BaseDialog.DayNight" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <!-- Dialog message text style. -->
        <item name="materialAlertDialogBodyTextStyle">@style/BaseDialog.Message.Text.Dark</item>
    </style>

    <!-- BaseDialog Framework DayNight theme, see values/themes.xml. -->
    <style name="ThemeOverlay.BaseDialog.Framework.DayNight" parent="@android:style/Theme.Material.Dialog.Alert">
        <!-- Material 3 colours from the context theme (also dynamic colours) and dialog shape. -->
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorAlertDialogListItem">?attr/colorOnSurface</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorControlHighlight">?attr/colorControlHighlight</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">28dp</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog.Flush</item>
    </style>

</resources>
