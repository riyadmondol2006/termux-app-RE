    <!-- Backup and restore -->
    <string name="feature_files_backup_title">Backup and restore</string>
    <string name="feature_files_backup_intro">Save a compressed Termux RE archive. Settings and ~/.termux are always included. Storage symlinks are saved as links; shared storage contents are not followed.</string>
    <string name="feature_files_backup_warning">Stop commands that modify files before backing up or restoring. Archives may contain passwords and private keys.</string>
    <string name="feature_files_backup_options">What to include</string>
    <string name="feature_files_backup_home">Include entire home directory</string>
    <string name="feature_files_backup_prefix">Include installed packages ($PREFIX)</string>
    <string name="feature_files_backup_caches">Skip cache, .cache and tmp directories</string>
    <string name="feature_files_backup_save_section">Backup</string>
    <string name="feature_files_backup_save">Save backup</string>
    <string name="feature_files_backup_restore_section">Restore</string>
