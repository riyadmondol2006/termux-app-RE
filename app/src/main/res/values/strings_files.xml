    <string name="feature_files_backup_review">Review and restore</string>
    <string name="feature_files_backup_restore_hint">Choose an archive first. It is checked before you can restore it.</string>
    <string name="feature_files_backup_status">Status</string>
    <string name="feature_files_backup_cancel">Cancel current operation</string>
    <string name="feature_files_backup_confirm_title">Replace matching files?</string>
    <string name="feature_files_backup_confirm_message">%1$s\n\nExisting files with matching paths will be replaced. Other files remain. This may change settings and installed packages. Restore is not atomic; cancellation leaves completed changes. Stop terminal commands first. Restart Termux after restoring.</string>
