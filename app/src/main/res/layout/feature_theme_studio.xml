<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <include layout="@layout/partial_primary_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.termux.app.features.theme.ThemePreviewView
                    android:id="@+id/feature_theme_preview"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:importantForAccessibility="no" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Themes -->
            <TextView
                style="@style/FeatureThemeSectionTitle"
                android:text="@string/feature_theme_gallery" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/feature_theme_gallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />

            </HorizontalScrollView>

            <!-- Editor -->
            <TextView
                style="@style/FeatureThemeSectionTitle"
                android:text="@string/feature_theme_editor" />

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/feature_theme_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feature_theme_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords"
                    android:maxLength="64"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/FeatureThemeSubtitle"
                android:text="@string/feature_theme_colors_base" />

            <LinearLayout
                android:id="@+id/feature_theme_colors_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/FeatureThemeSubtitle"
                android:text="@string/feature_theme_colors_ansi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feature_theme_colors_ansi_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/feature_theme_colors_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/feature_theme_colors_bright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <!-- Font -->
            <TextView
                style="@style/FeatureThemeSectionTitle"
                android:text="@string/feature_theme_font" />

            <TextView
                android:id="@+id/feature_theme_font_size_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.slider.Slider
                android:id="@+id/feature_theme_font_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/feature_theme_font"
                android:stepSize="1"
                android:valueFrom="6"
                android:valueTo="32" />

            <TextView
                android:id="@+id/feature_theme_font_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/feature_theme_bundled_font"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_bundled_font" />

                <Button
                    android:id="@+id/feature_theme_import_font"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_import_font" />

            </LinearLayout>

            <!-- Cursor -->
            <TextView
                style="@style/FeatureThemeSectionTitle"
                android:text="@string/feature_theme_cursor_section" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/feature_theme_cursor_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/feature_theme_cursor_block"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_cursor_block" />

                <Button
                    android:id="@+id/feature_theme_cursor_underline"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_cursor_underline" />

                <Button
                    android:id="@+id/feature_theme_cursor_bar"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_cursor_bar" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/feature_theme_cursor_blink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/feature_theme_cursor_blink"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <!-- Background image -->
            <TextView
                style="@style/FeatureThemeSectionTitle"
                android:text="@string/feature_theme_background_section" />

            <TextView
                android:id="@+id/feature_theme_background_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/feature_theme_pick_background"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_pick_background" />

                <Button
                    android:id="@+id/feature_theme_clear_background"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_clear_background" />

            </LinearLayout>

            <!-- Import and export -->
            <TextView
                style="@style/FeatureThemeSectionTitle"
                android:text="@string/feature_theme_share" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/feature_theme_import"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_import" />

                <Button
                    android:id="@+id/feature_theme_export"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/feature_theme_export" />

            </LinearLayout>

            <Button
                android:id="@+id/feature_theme_delete"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/feature_theme_delete"
                android:textColor="?attr/colorError" />

        </LinearLayout>

    </ScrollView>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/feature_theme_save"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/feature_theme_save_copy" />

        <Button
            android:id="@+id/feature_theme_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/feature_theme_apply" />

    </LinearLayout>

</LinearLayout>
