<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 switch for SwitchPreferenceCompat, replaces androidx.preference's
  preference_widget_switch_compat.xml. MaterialSwitch extends SwitchCompat, which
  SwitchPreferenceCompat requires for the switchWidget view.
  -->
<com.google.android.material.materialswitch.MaterialSwitch xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false" />
