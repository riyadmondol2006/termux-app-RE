# Generated by Termux RE, changes are overwritten.
# Sourced by bash at the first prompt of terminal sessions started by the app, after its startup
# files like ~/.bashrc, through the PROMPT_COMMAND the session was started with. Sets up command
# notifications and sources the startup files listed in $TERMUX_RE_STARTUP.

# Remove this script from PROMPT_COMMAND and don't pass PROMPT_COMMAND to programs.
PROMPT_COMMAND="${PROMPT_COMMAND//"@BASH_PROMPT_COMMAND@"/:}"
export -n PROMPT_COMMAND

if [ -n "${TERMUX_RE_NOTIFY_AFTER-}" ] && [ -z "${__termux_re_notify_after-}" ]; then
    __termux_re_notify_after="$TERMUX_RE_NOTIFY_AFTER"
    __termux_re_noop=
    __termux_re_cmd_start=

    # Ask the terminal to show a notification for a finished command with OSC 777.
    __termux_re_notify() {
        local command="${1//[[:cntrl:]]/ }" title duration
        [ "${#command}" -gt 200 ] && command="${command:0:200}…"
        if [ "$2" = 0 ]; then title="Command finished"; else title="Command failed (exit $2)"; fi
        if [ "$3" -ge 60 ]; then duration="$(($3 / 60))m $(($3 % 60))s"; else duration="$3s"; fi
        printf '\033]777;notify;%s;%s\007' "$title" "${command:+$command · }$duration"
    }

    __termux_re_precmd() {
        local exit_status=$? duration command
        if [ -n "$__termux_re_cmd_start" ]; then
            duration=$((SECONDS - __termux_re_cmd_start))
            __termux_re_cmd_start=
            if [ "$duration" -ge "$__termux_re_notify_after" ]; then
                command=$(HISTTIMEFORMAT= builtin history 1 2>/dev/null)
                command="${command#"${command%%[![:space:]]*}"}"
                command="${command#*[[:space:]]}"
                command="${command#"${command%%[![:space:]]*}"}"
                __termux_re_notify "$command" "$exit_status" "$duration"
            fi
        fi
        return $exit_status
    }

    # PS0 is expanded before a command runs: store the start time without running a subshell.
    PS0="${PS0-}"'${__termux_re_noop:$((__termux_re_cmd_start=SECONDS)):0}'
    PROMPT_COMMAND="__termux_re_precmd;${PROMPT_COMMAND-}"
fi
unset TERMUX_RE_NOTIFY_AFTER

if [ -n "${TERMUX_RE_STARTUP-}" ]; then
    __termux_re_startup="$TERMUX_RE_STARTUP"
    unset TERMUX_RE_STARTUP
    while [ -n "$__termux_re_startup" ]; do
        __termux_re_file="${__termux_re_startup%%:*}"
        if [ "$__termux_re_file" = "$__termux_re_startup" ]; then __termux_re_startup=; else __termux_re_startup="${__termux_re_startup#*:}"; fi
        if [ -r "$__termux_re_file" ]; then . "$__termux_re_file"; fi
    done
    unset __termux_re_startup __termux_re_file
fi
