# Generated by Termux RE, changes are overwritten.
# Sourced by fish with --init-command in terminal sessions started by the app, after its config
# files. Sets up command notifications and sources the startup files listed in $TERMUX_RE_STARTUP.

if set -q TERMUX_RE_NOTIFY_AFTER; and not set -q __termux_re_notify_after
    set -g __termux_re_notify_after $TERMUX_RE_NOTIFY_AFTER

    # Ask the terminal to show a notification for a finished command with OSC 777.
    function __termux_re_postexec --on-event fish_postexec
        set -l exit_status $status
        set -l duration (math --scale=0 "$CMD_DURATION / 1000")
        if test "$duration" -ge "$__termux_re_notify_after"
            set -l command (string join ' ' -- $argv | string replace -ra '[[:cntrl:]]' ' ')
            if test (string length -- "$command") -gt 200
                set command (string sub -l 200 -- "$command")…
            end
            set -l title "Command finished"
            if test $exit_status -ne 0
                set title "Command failed (exit $exit_status)"
            end
            set -l duration_text "$duration"s
            if test $duration -ge 60
                set duration_text (math --scale=0 "floor($duration / 60)")m (math "$duration % 60")s
                set duration_text (string join ' ' -- $duration_text)
            end
            if test -n "$command"
                set duration_text "$command · $duration_text"
            end
            printf '\e]777;notify;%s;%s\a' "$title" "$duration_text"
        end
    end
end
set -e TERMUX_RE_NOTIFY_AFTER

if set -q TERMUX_RE_STARTUP
    set -l __termux_re_startup (string split ':' -- "$TERMUX_RE_STARTUP")
    set -e TERMUX_RE_STARTUP
    for __termux_re_file in $__termux_re_startup
        if test -n "$__termux_re_file"; and test -r "$__termux_re_file"
            source "$__termux_re_file"
        end
    end
end
