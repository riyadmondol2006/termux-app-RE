# Generated by Termux RE, changes are overwritten.
# Sourced by zsh at the first prompt of terminal sessions started by the app, after its startup
# files like ~/.zshrc, see zsh/.zshenv. Sets up command notifications and sources the startup files
# listed in $TERMUX_RE_STARTUP.

if [[ -n "${TERMUX_RE_NOTIFY_AFTER-}" && -z "${__termux_re_notify_after-}" ]]; then
    typeset -g __termux_re_notify_after="$TERMUX_RE_NOTIFY_AFTER" __termux_re_cmd_start= __termux_re_cmd=

    # Ask the terminal to show a notification for a finished command with OSC 777.
    __termux_re_notify() {
        local command="${1//[[:cntrl:]]/ }" title duration
        (( ${#command} > 200 )) && command="${command[1,200]}…"
        if [[ "$2" == 0 ]]; then title="Command finished"; else title="Command failed (exit $2)"; fi
        if (( $3 >= 60 )); then duration="$(($3 / 60))m $(($3 % 60))s"; else duration="$3s"; fi
        printf '\033]777;notify;%s;%s\007' "$title" "${command:+$command · }$duration"
    }

    __termux_re_preexec() {
        __termux_re_cmd_start=$SECONDS
        __termux_re_cmd="$1"
    }

    __termux_re_precmd() {
        local exit_status=$? duration
        if [[ -n "$__termux_re_cmd_start" ]]; then
            duration=$(( SECONDS - __termux_re_cmd_start ))
            __termux_re_cmd_start=
            if (( duration >= __termux_re_notify_after )); then
                __termux_re_notify "$__termux_re_cmd" "$exit_status" "$duration"
            fi
        fi
        return $exit_status
    }

    preexec_functions+=(__termux_re_preexec)
    precmd_functions=(__termux_re_precmd $precmd_functions)
fi
unset TERMUX_RE_NOTIFY_AFTER

if [[ -n "${TERMUX_RE_STARTUP-}" ]]; then
    typeset -g __termux_re_startup="$TERMUX_RE_STARTUP" __termux_re_file
    unset TERMUX_RE_STARTUP
    for __termux_re_file in ${(s.:.)__termux_re_startup}; do
        if [[ -r "$__termux_re_file" ]]; then builtin source "$__termux_re_file"; fi
    done
    unset __termux_re_startup __termux_re_file
fi
