<shortcuts xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        For shortcut.xml:
        The targetPackage values and the failsafe_session extra name are replaced at build time
        with the termuxPackageName Gradle property by gradle/termux-identity.gradle, since
        ${applicationId} and resource strings do not work here.
        targetClass uses the Java namespace "com.termux", which does not change with the
        package name. The dot (.) prefix does not work here to prefix it automatically.
    -->

    <shortcut
        android:shortcutId="new_session"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_session"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.termux.re"
            android:targetClass="com.termux.app.TermuxActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

    <shortcut
        android:shortcutId="new_failsafe_session"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_session_failsafe"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.termux.re"
            android:targetClass="com.termux.app.TermuxActivity"
            android:name="android.shortcut.conversation">
            <extra android:name="com.termux.re.app.failsafe_session" android:value="true"/>
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings"
        android:shortcutShortLabel="@string/action_open_settings"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.termux.re"
            android:targetClass="com.termux.app.activities.SettingsActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

</shortcuts>
